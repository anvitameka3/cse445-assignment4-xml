<?xml version="1.0" encoding="utf-8"?>
<!-- Anvita Meka - CSE 445 Assignment 4.
     Reorganized into explicit named complex types following the CSE445 Courses.xsd example.
     Name, Phone(s), Address and address subfields remain sequenced as in Figure 1.
     Phone accepts one or more values; Rating is optional; NearestAirport is required.
     Number and Zip are xs:int, as recommended by the Gradescope course FAQ. -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xsd:element name="NationalParks" type="NationalParksType" />

  <xsd:complexType name="NationalParksType">
    <xsd:sequence>
      <xsd:element name="NationalPark" type="NationalParkType"
                   minOccurs="1" maxOccurs="unbounded" />
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="NationalParkType">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string" />
      <xsd:element name="Phone" type="xsd:string"
                   minOccurs="1" maxOccurs="unbounded" />
      <xsd:element name="Address" type="AddressType" />
    </xsd:sequence>
    <xsd:attribute name="Rating" type="xsd:float" use="optional" />
  </xsd:complexType>

  <xsd:complexType name="AddressType">
    <xsd:sequence>
      <xsd:element name="Number" type="xsd:int" />
      <xsd:element name="Street" type="xsd:string" />
      <xsd:element name="City" type="xsd:string" />
      <xsd:element name="State" type="xsd:string" />
      <xsd:element name="Zip" type="xsd:int" />
    </xsd:sequence>
    <xsd:attribute name="NearestAirport" type="xsd:string" use="required" />
  </xsd:complexType>
</xsd:schema>
